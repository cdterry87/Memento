        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "jiti": "^2.7.0",
        "jsdom": "^31.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
